# Real Cloud Tasks + Cloud Run test (copy values into .env)
# Do NOT put service-account private keys in git. Prefer a file:
#   GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\gcs-sa.json

CLOUD_DRY_RUN=false
LOCAL_INLINE_PARSE=false

MONGO_URI=mongodb://localhost:27017
MONGO_DB=causelists

GCP_PROJECT_ID=legixo
GCP_LOCATION=asia-south1

SCRAPE_QUEUE=scrape-jobs
PARSE_QUEUE=parse-jobs

# From: gcloud run services describe causelist-worker --region asia-south1 --format='value(status.url)'
SCRAPER_SERVICE_URL=https://causelist-worker-XXXX-as.a.run.app
PARSER_SERVICE_URL=https://causelist-worker-XXXX-as.a.run.app

# From setup-cloud-tasks.ps1
TASK_SERVICE_ACCOUNT_EMAIL=cloud-tasks-invoker@legixo.iam.gserviceaccount.com

GCS_BUCKET=legixo-docs-dev
# GOOGLE_APPLICATION_CREDENTIALS=.\secrets\gcs-sa.json
