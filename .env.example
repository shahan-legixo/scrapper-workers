# Copy to .env and fill in real values for cloud.
# Local default: CLOUD_DRY_RUN=true (no real GCS / Cloud Tasks calls).

# --- MongoDB (required for upsert + scrape_jobs) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=causelists
# Collections (fixed): CauseList, CauseListItem, scrape_jobs

# --- Cloud mode ---
# true  = simulate Cloud Tasks + GCS (local / CI)
# false = real Cloud Tasks enqueue (needs cloudtasks.tasks.create on GCP_PROJECT_ID)
CLOUD_DRY_RUN=true
# After scrape, parse in-process (no Cloud Tasks delivery). Keep false for real Tasks.
LOCAL_INLINE_PARSE=false

# --- GCP project / region (Cloud Tasks + Cloud Run host project) ---
GCP_PROJECT_ID=legixo
GCP_LOCATION=asia-south1

# --- Cloud Tasks queues ---
SCRAPE_QUEUE=cause-list-scrape
PARSE_QUEUE=cause-list-parse

# --- Cloud Run worker URLs (OIDC audience = service URL) ---
SCRAPER_SERVICE_URL=https://your-scraper-worker.run.app
PARSER_SERVICE_URL=https://your-parser-worker.run.app
# Optional alias used if SCRAPER_SERVICE_URL unset:
# SERVICE_URL=https://your-scraper-worker.run.app

# --- Cloud Tasks invoker service account ---
TASK_SERVICE_ACCOUNT_EMAIL=cloud-tasks-invoker@your-project-id.iam.gserviceaccount.com

# --- Cloud Storage ---
# PDFs land at: gs://GCS_BUCKET/<courtKey>/<date>/<listType>/<file>.pdf
GCS_BUCKET=causelists-pdfs
